[Unit]
Description=Heliostat Remote UI
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/heliostat/remote-access/rpi
ExecStart=/opt/heliostat/remote-access/rpi/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8088
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
